# ---------- AI (Gemini / OpenAI / OpenCode / Groq / Anthropic) ----------
# Pick one. Leave all blank for deterministic simulation (no billing, tests pass).
LLM_PROVIDER=gemini
# gemini | openai | opencode | groq | anthropic | openai_compatible | disabled
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# Google Gemini API (Free tier from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# OpenAI (default models)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
SUPERVISOR_MODEL=gpt-4o-mini
SUB_AGENT_MODEL=gpt-4o-mini

# OpenCode Zen / OpenAI-compatible gateway (treated as OpenAI-compatible)
# Get key from OpenCode dashboard, set model e.g. opencode/gpt-4o-mini or provider default.
OPENCODE_API_KEY=your_opencode_api_key_here
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL=

# Groq (fast, cheap)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# ---------- Database (SQLite default, Postgres for Supabase/Neon) ----------
# Local/dev: leave blank -> SQLite src/app/data/finpilot.db
# Production (Supabase/Neon/Render Postgres): set full URL, e.g.
# DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres?sslmode=require
# DATABASE_URL=postgresql://user:pass@ep-xxxx.neon.tech:5432/finpilot?sslmode=require
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Frontend CORS (comma-separated). Use "*" for dev, your domain(s) in prod.
CORS_ORIGINS=*

# Razorpay Integration
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=secret_placeholder

# Financial Governance & Policy Thresholds (INR)
HITL_APPROVAL_THRESHOLD_INR=50000.0
AUTONOMOUS_PAYOUT_LIMIT_INR=10000.0
